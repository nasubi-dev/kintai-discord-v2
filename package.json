{
  "name": "kintai-discord",
  "version": "2.0.0",
  "description": "Discord slash command attendance management bot using Hono framework on Cloudflare Workers",
  "license": "MIT",
  "scripts": {
    "dev": "CLOUDFLARE_INCLUDE_PROCESS_ENV=true op run --env-file=.env.tpl -- wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "register-commands": "op run --env-file=.env.tpl -- bun run register-commands.js",
    "setup": "cp wrangler.jsonc.example wrangler.jsonc",
    "secrets:setup": "op run --env-file=.env.tpl -- bun run scripts/setup-secrets.js",
    "kv:setup": "bash scripts/setup-kv.sh",
    "list-guilds": "op run --env-file=.env.tpl -- bun run scripts/list-guilds.js",
    "guild-count": "op run --env-file=.env.tpl -- bun run scripts/guild-count.js"
  },
  "dependencies": {
    "@types/node": "^24.0.3",
    "discord-api-types": "^0.38.13",
    "dotenv": "^16.5.0",
    "hono": "^4.8.2"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.4.0"
  }
}
